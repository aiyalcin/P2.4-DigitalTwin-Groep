# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
2.4-UNITY-GROEP/.utmp/
2.4-UNITY-GROEP/[Ll]ibrary/
2.4-UNITY-GROEP/[Tt]emp/
2.4-UNITY-GROEP/[Oo]bj/
2.4-UNITY-GROEP/[Bb]uild/
2.4-UNITY-GROEP/[Bb]uilds/
2.4-UNITY-GROEP/[Ll]ogs/
2.4-UNITY-GROEP/[Uu]ser[Ss]ettings/
2.4-UNITY-GROEP/*.log

2.4-UNITY-GROEP/.vscode
2.4-UNITY-GROEP/Temp
2.4-UNITY-GROEP/result
2.4-UNITY-GROEP/Logs
2.4-UNITY-GROEP/Library
2.4-UNITY-GROEP/obj

ml-env


# By default unity supports Blender asset imports, *.blend1 blender files do not need to be committed to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
2.4-UNITY-GROEP/[Mm]emoryCaptures/

# Recordings can get excessive in size
2.4-UNITY-GROEP/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# 2.4-UNITY-GROEP/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
2.4-UNITY-GROEP/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
2.4-UNITY-GROEP/[Ss]erverData
2.4-UNITY-GROEP/[Aa]ssets/StreamingAssets/aa*
2.4-UNITY-GROEP/[Aa]ssets/AddressableAssetsData/link.xml*
2.4-UNITY-GROEP/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
2.4-UNITY-GROEP/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
2.4-UNITY-GROEP/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
2.4-UNITY-GROEP/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
2.4-UNITY-GROEP/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
2.4-UNITY-GROEP/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
2.4-UNITY-GROEP/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
